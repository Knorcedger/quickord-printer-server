{
  "name": "quickord-printer-server",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "test:watch": "vitest",
    "ci": "sh ./scripts/ci.sh",
    "start": "npm run start:test",
    "start:dev": "tsx watch src/index.ts --noupdate",
    "start:test": "tsx watch src/index.ts",
    "start:ci": "node ./dist/index.js",
    "test": "vitest run",
    "lint": "eslint src test vitest.config.ts eslint.config.mjs",
    "lint:fix": "eslint src test vitest.config.ts eslint.config.mjs --fix",
    "format": "prettier --write src test vitest.config.ts eslint.config.mjs",
    "format:check": "prettier --check src test vitest.config.ts eslint.config.mjs",
    "dev": "npm run start:test",
    "debug": "node --inspect=0.0.0.0:9229 -r ts-node/register src/index.ts --watch",
    "----------------------------------Typescript----------------------------------": "",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && sh ./scripts/build.sh",
    "build:code": "rm -rf dist && mkdir dist && npx tsc --outDir dist/src",
    "build:watch": "tsx watch ./src --exec 'npm run build'",
    "build:bundle": "esbuild ./dist/src/index.js --bundle --platform=node --target=node24.8.0 --outfile=./dist/bundle.cjs --external:serialport --external:@serialport/bindings* --external:*.node",
    "----------------------------------Build----------------------------------": "",
    "build:exe": "npm run build:bundle && nexe ./dist/bundle.cjs --target windows-x64-24.8.0 --build --verbose --external:serialport --external:@serialport/bindings* --external:*.node --output builds/builds/printerServer.exe",
    "build:updater": "npx esbuild ./updater-exe/updater.js --bundle --platform=node --target=node24.8.0 --outfile=./dist/updater.cjs && nexe ./dist/updater.cjs --target windows-x64-24.8.0 --build --output updater.exe",
    "copy-bindings": "cp -r node_modules/@serialport* builds/node_modules/@serialport"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@serialport/bindings-cpp": "^12.0.1",
    "@types/jszip": "^3.4.0",
    "adm-zip": "^0.5.15",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "iconv-lite": "^0.4.24",
    "jszip": "^3.10.1",
    "nanoid": "^5.0.4",
    "nconf": "^0.12.1",
    "network": "^0.7.0",
    "node-fetch": "^3.3.2",
    "node-gyp-build": "^4.8.4",
    "node-thermal-printer": "^4.4.3",
    "serialport": "^12.0.0",
    "signale": "^1.4.0",
    "undici": "~7.14.0",
    "unzipper": "^0.12.3",
    "yauzl-promise": "^4.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/rest": "^20.1.1",
    "@types/adm-zip": "^0.5.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.4.4",
    "@types/nconf": "^0.10.6",
    "@types/signale": "^1.4.7",
    "@types/unzipper": "^0.10.11",
    "@types/yauzl-promise": "^4.0.1",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^24.8.0"
  }
}
